# Copy this file to .env and fill values before running the app.

# Server port
PORT=5000

# MongoDB Atlas connection string (keep empty in repo). Example format:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# JWT secret used to sign tokens. Keep this secret in production.
JWT_SECRET=
